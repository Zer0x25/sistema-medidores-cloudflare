{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-medidores-edge",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "metric.zer0x.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistema-medidores-db",
      "database_id": "6ea20176-bed0-44b1-8126-01d6a232e082",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "0ac2ac688f814f41b294c7b509759009"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "JWT_SECRET": "desarrollo_local_jwt_secret_minimo_32_caracteres_cloudflare",
    "JWT_EXPIRES_IN": "8h",
    "LOG_LEVEL": "info"
  }
}