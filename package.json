{
  "name": "sistema-medidores-cloudflare",
  "version": "0.1.0",
  "description": "Sistema de gestión y auditoría de medidores en Cloudflare Workers y D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "prisma generate && wrangler types && tsc --noEmit",
    "typecheck": "prisma generate && wrangler types && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "node scripts/test-contract-symmetry.mjs",
    "test:contract:remote": "node scripts/test-contract-symmetry.mjs --remote",
    "verify": "./scripts/verify.sh",
    "setup": "./scripts/setup-local.sh",
    "cf-typegen": "wrangler types",
    "prisma:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply sistema-medidores-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sistema-medidores-db --remote",
    "db:seed:local": "wrangler d1 execute sistema-medidores-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute sistema-medidores-db --remote --file=./migrations/0002_seed.sql",
    "db:reset:local": "./scripts/db-reset-local.sh",
    "db:backup:remote": "./scripts/backup-remote.sh --remote",
    "db:backup:local": "./scripts/backup-remote.sh --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@prisma/adapter-d1": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^3.111.0"
  }
}
