# ==============================================================================
# VARIABLES Y SECRETOS DE DESARROLLO LOCAL (Wrangler .dev.vars)
# ==============================================================================
# Generar .dev.vars con: node scripts/create-local-secrets.mjs
# Producción: JWT_SECRET solo como secreto protegido de Cloudflare.
# ==============================================================================

# Clave secreta para firma y verificación de JWT (mínimo 32 caracteres)
JWT_SECRET=REEMPLAZAR_CON_CLAVE_LOCAL_ALEATORIA

# Tiempo de vida de los tokens JWT
JWT_EXPIRES_IN=8h

# Entorno de ejecución (development | staging | production)
NODE_ENV=development

# Nivel de logging
LOG_LEVEL=debug
